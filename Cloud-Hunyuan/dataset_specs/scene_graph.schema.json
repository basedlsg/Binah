{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene Graph Schema",
  "description": "Defines the structure of a 3D scene, including objects, their properties, relations, and camera information.",
  "type": "object",
  "properties": {
    "world_id": {
      "description": "Unique identifier for the world.",
      "type": "string"
    },
    "objects": {
      "description": "List of objects in the scene.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "mesh_uri": { "type": "string", "format": "uri" },
          "transform": {
            "description": "4x4 transformation matrix.",
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            },
            "minItems": 4,
            "maxItems": 4
          },
          "aabb": {
            "description": "Axis-aligned bounding box [min_corner, max_corner].",
            "type": "object",
            "properties": {
              "min_corner": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "max_corner": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            },
            "required": ["min_corner", "max_corner"]
          },
          "centroid": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "material": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "texture": { "type": "string" }
            }
          }
        },
        "required": ["id", "label", "transform", "aabb"]
      }
    },
    "relations": {
      "description": "List of spatial or semantic relations between objects.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["left_of", "right_of", "above", "below", "in_front_of", "behind", "touching", "contains"] },
          "subject": { "type": "string" },
          "object": { "type": "string" }
        },
        "required": ["type", "subject", "object"]
      }
    },
    "cameras": {
      "description": "List of cameras used to render the scene.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "pose": {
            "description": "4x4 camera-to-world transformation matrix.",
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            },
            "minItems": 4,
            "maxItems": 4
          },
          "intrinsics": {
            "description": "3x3 camera intrinsic matrix.",
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 3,
            "maxItems": 3
          },
          "fov": { "type": "number" }
        },
        "required": ["id", "pose", "intrinsics"]
      }
    }
  },
  "required": ["world_id", "objects", "relations", "cameras"]
}