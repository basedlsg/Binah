# Quest Dev Copilot - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ======================
# API Keys (Required)
# ======================
LLAMA_API_KEY=your_llama_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ======================
# Database Configuration
# ======================
CHROMA_PERSIST_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=quest_errors

# ======================
# Flask Backend Settings
# ======================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_SECRET_KEY=your_secret_key_for_sessions

# ======================
# AI Model Configuration
# ======================
# Classification model (faster, cheaper)
LLAMA_CLASSIFICATION_MODEL=Llama-4-Scout-17B-16E-Instruct-FP8
# Fix generation model (more capable)
LLAMA_FIX_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# Embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ======================
# AI Parameters
# ======================
DEFAULT_TEMPERATURE=0.2
MAX_TOKENS_CLASSIFICATION=1000
MAX_TOKENS_FIX=2048
SCOUT_TOKEN_LIMIT=128000

# ======================
# Cost Management
# ======================
DAILY_TOKEN_BUDGET=500000
COST_PER_1K_TOKENS=0.002
ENABLE_COST_TRACKING=true

# ======================
# Rate Limiting
# ======================
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=1000

# ======================
# Forum Scraping
# ======================
EPIC_FORUMS_BASE=https://forums.unrealengine.com
META_FORUMS_BASE=https://communityforums.atmeta.com
SCRAPER_DELAY_SECONDS=1
MAX_PAGES_TO_SCRAPE=300

# ======================
# Development Settings
# ======================
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600

# ======================
# Unreal Plugin Settings
# ======================
UE_PLUGIN_BACKEND_URL=http://localhost:5000
UE_MAX_LOG_LINES=5000
UE_AUTO_APPLY_FIXES=false

# ======================
# Optional Features
# ======================
ENABLE_SCREENSHOTS=false
ENABLE_AUTO_FIX=true
ENABLE_FORUM_SCRAPING=true